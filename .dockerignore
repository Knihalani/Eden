# Patterns here match from the context root only (unlike .gitignore): anything that may sit in a subdirectory too
# needs "**/", or `COPY packages`/`COPY examples` puts it in an image layer.
**/node_modules
archived
.git
native
bench
docs
!docs/profiles
**/*.db
**/*.db-wal
**/*.db-shm
# Secrets and local data at any depth: Bun loads .env from the directory it runs in, and lab runs write .local/.
**/.env
**/.env.*
**/.local
**/.eden-local
**/.eden
**/.tmp-*
**/.probe
deploy
**/.env
**/.env.*
