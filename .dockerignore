# Patterns here match from the context root only (unlike .gitignore): anything that may sit in a subdirectory too
# needs "**/", or `COPY packages`/`COPY examples` puts it in an image layer.
**/node_modules
archived
.git
native
bench
docs
!docs/profiles
**/*.db
**/*.db-wal
**/*.db-shm
# Secrets and local data at any depth: Bun loads .env from the directory it runs in, and lab runs write .local/.
**/.env
**/.env.*
**/.local
**/.eden-local
**/.eden
**/.tmp-*
**/.probe
deploy
**/.env
**/.env.*
# Not served (D1700): the lab (@eden/sim: its harnesses, suites and paid-run scripts; only its package.json stays, for
# the workspace install), tests and benches. scripts/dockerfile.test.ts walks the servers' imports and fails if any of
# them lands under one of these.
packages/sim/**
!packages/sim/package.json
**/*.test.ts
packages/*/bench
# The secret gate's test support (D1705): it imports re2js, a devDependency the production install leaves out.
packages/redact/src/re2-oracle.ts
packages/redact/src/differential.ts
