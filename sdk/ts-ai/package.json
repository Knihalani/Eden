{
  "name": "@eden-ai/sdk",
  "version": "0.4.1",
  "description": "Eden TypeScript runtime SDK — auto-instrumentation for OpenAI, Anthropic, Vercel AI, LangChain, Mastra, Bedrock, and Gemini with fire-and-forget telemetry to the Eden gateway.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./instrumentations/openai": {
      "types": "./dist/instrumentations/openai.d.ts",
      "import": "./dist/instrumentations/openai.js"
    },
    "./instrumentations/anthropic": {
      "types": "./dist/instrumentations/anthropic.d.ts",
      "import": "./dist/instrumentations/anthropic.js"
    },
    "./instrumentations/vercel-ai": {
      "types": "./dist/instrumentations/vercel-ai.d.ts",
      "import": "./dist/instrumentations/vercel-ai.js"
    },
    "./instrumentations/langchain": {
      "types": "./dist/instrumentations/langchain.d.ts",
      "import": "./dist/instrumentations/langchain.js"
    },
    "./instrumentations/mastra": {
      "types": "./dist/instrumentations/mastra.d.ts",
      "import": "./dist/instrumentations/mastra.js"
    },
    "./model-advisor": {
      "types": "./dist/model_advisor.d.ts",
      "import": "./dist/model_advisor.js"
    }
  },
  "bin": {
    "eden-doctor": "./bin/eden-doctor.mjs"
  },
  "files": [
    "bin",
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/doctor.ts src/model_advisor.ts src/instrumentations/openai.ts src/instrumentations/anthropic.ts src/instrumentations/vercel-ai.ts src/instrumentations/langchain.ts src/instrumentations/mastra.ts src/instrumentations/providers.ts --format esm,cjs --dts --clean",
    "typecheck": "tsc --noEmit",
    "doctor": "bun run src/doctor.ts",
    "test": "bun test tests/",
    "lint": "tsc --noEmit",
    "test:parallel": "bun test --parallel tests/"
  },
  "peerDependencies": {
    "openai": "4.73.0",
    "@anthropic-ai/sdk": "*",
    "ai": "latest",
    "@langchain/core": "latest",
    "@opentelemetry/sdk-trace-node": "*",
    "@opentelemetry/sdk-trace-base": "*",
    "@opentelemetry/exporter-trace-otlp-http": "*"
  },
  "peerDependenciesMeta": {
    "openai": {
      "optional": true
    },
    "@anthropic-ai/sdk": {
      "optional": true
    },
    "ai": {
      "optional": true
    },
    "@langchain/core": {
      "optional": true
    },
    "@mastra/core": {
      "optional": true
    },
    "mastra": {
      "optional": true
    },
    "@opentelemetry/sdk-trace-node": {
      "optional": true
    },
    "@opentelemetry/sdk-trace-base": {
      "optional": true
    },
    "@opentelemetry/exporter-trace-otlp-http": {
      "optional": true
    }
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "0.115.0",
    "@langchain/core": "^0.3.0",
    "@google/generative-ai": "^0.24.1",
    "ai": "^4.0.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.57.2",
    "@opentelemetry/sdk-trace-base": "1.30.1",
    "@opentelemetry/sdk-trace-node": "1.30.1",
    "@types/bun": "latest",
    "groq-sdk": "^1.5.0",
    "openai": "4.73.0",
    "tsup": "^8.2.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=18",
    "bun": ">=1.1.0"
  },
  "license": "MIT",
  "homepage": "https://eden.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eden-ai/eden.git",
    "directory": "sdk/ts-ai"
  },
  "bugs": {
    "url": "https://github.com/eden-ai/eden/issues"
  },
  "sideEffects": false,
  "keywords": [
    "eden",
    "ai",
    "observability",
    "openai",
    "anthropic",
    "vercel-ai",
    "langchain",
    "bedrock",
    "gemini",
    "tracing",
    "telemetry",
    "llm",
    "agents"
  ]
}
