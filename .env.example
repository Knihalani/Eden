# Eden Environment Configuration

# OpenRouter
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# PostgreSQL (via PgBouncer on port 6432)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=eden
POSTGRES_USER=eden
POSTGRES_PASSWORD=change_me_in_production

# Postgres (Neon) — SSL config for the cutover. Set both for Neon.
# Leave empty for local dev (plain postgres:// DSN).
POSTGRES_SSLMODE=
POSTGRES_CHANNEL_BINDING=
POSTGRES_ENDPOINT_ID=

# Qdrant Vector Database
# Qdrant Cloud: hostname only (not a full URL). Set QDRANT_HTTPS=true
# and QDRANT_API_KEY from the Cloud dashboard. Missing HTTPS against a
# *.cloud.qdrant.io host used to fall back to plain HTTP → Errno 99.
QDRANT_HOST=localhost
QDRANT_HTTPS=false
QDRANT_PORT=6333
QDRANT_API_KEY=
QDRANT_COLLECTION_PREFIX=eden_

# Typesense — full-text search across spans (Phase B).
# REQUIRED: docker-compose will refuse to boot without this key set.
# Generate with:  openssl rand -hex 32
# The same value must be set on both sides (Eden API + Typesense container).
TYPESENSE_HOST=localhost
TYPESENSE_PORT=8108
TYPESENSE_API_KEY=

# Application
APP_NAME=Eden
APP_VERSION=0.1.0
DEBUG=false
HOST=0.0.0.0
PORT=8000

# Sandbox
SANDBOX_MEMORY_MB=512
SANDBOX_CPU_COUNT=2
SANDBOX_SNAPSHOT_POOL_SIZE=10
SANDBOX_MAX_CONCURRENT=100

# Agent Token Budgets
MAX_TOKENS_PLANNER=50000
MAX_TOKENS_CRITIC=30000
MAX_TOKENS_REFINER=25000
MAX_TOKENS_FACT_CHECKER=25000
MAX_TOKENS_EXECUTOR=15000
MAX_TOKENS_CODE_QUALITY=10000
MAX_TOKENS_VERIFIER=10000
MAX_TOKENS_TESTER=10000
MAX_TOKENS_ARCHIVIST=60000

# Model Configuration
# OpenRouter — set OPENROUTER_API_KEY in production.
# Model selection is handled by ModelRouter tiers (see
# src/eden/optimization/model_router.py); per-slot env overrides
# are no longer used.

# Evolution Engine
# Auto-create a canary at this traffic % when the prompt evolver
# generates a new variant.  0 disables auto-canary creation
# (variants stay inactive until manually promoted).
EVOLVER_AUTO_CANARY_PCT=5

# MiniMax OpenAI-compatible (alternative to OpenRouter)
# When USE_MINIMAX=true, Eden routes LLM calls to MiniMax instead of
# OpenRouter. Set MINIMAX_API_KEY (do NOT commit) before flipping this.
USE_MINIMAX=false
MINIMAX_BASE_URL=https://api.minimax.io/v1
MINIMAX_MODEL=MiniMax-M3
MINIMAX_API_KEY=

# Postgres (Neon) — full DSN override. Takes precedence over POSTGRES_HOST etc.
# Set to a Neon connection string in production; leave empty for local dev
# (the connection builder falls back to plain postgres:// DSN).
# Quote the value when the URL contains query params (&) so `source .env` works.
DATABASE_URL=

# JWT + encryption — set both before any non-dev deploy. Generate with:
#   openssl rand -hex 32   (JWT_SECRET)
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"   (ENCRYPTION_KEY)
JWT_SECRET=<your-jwt-secret>
ENCRYPTION_KEY=<your-fernet-key>

# JWT audience/issuer — optional. Empty values are accepted by the
# legacy cookie flow but downstream services that validate the
# ``aud`` / ``iss`` claims need them populated.
JWT_AUDIENCE=
JWT_ISSUER=

# Rate limiting + pipeline timeout (the NF manifest sets these to
# match prod — see northflank.yml). Override locally to relax.
RATE_LIMIT_DEFAULT_PER_WINDOW=60
RATE_LIMIT_WINDOW_SECONDS=60
PIPELINE_TIMEOUT_SECONDS=300

# Production monitor (Cat 9 / Cat 22). ``production_monitor_use_llm_judge``
# is OFF by default — flipping it on costs ~$5/day per tenant at the
# current event rate. The judge also self-samples at 1% so a
# misconfigured tenant won't blow up the budget.
PRODUCTION_MONITOR_USE_LLM_JUDGE=false

# Object storage (Phase B1, 2026-06-19) — single bucket for bronze/silver/datasets.
# Leave EDEN_STORAGE_BACKEND empty for AWS S3 (uses AWS_* env vars).
# Set to "impossible_cloud" for the €7.99/TB/mo EU storage backend.
BRONZE_S3_BUCKET=eden-bronze
EDEN_STORAGE_BACKEND=
EDEN_STORAGE_ENDPOINT=
EDEN_STORAGE_ACCESS_KEY=<your-storage-access-key>
EDEN_STORAGE_SECRET_KEY=<your-storage-secret-key>

# Metrics scrape token — set on both Eden backend and Prometheus side.
# When empty, /metrics returns 503. When set, scrapers must send
# Authorization: Bearer <token>.
METRICS_BEARER_TOKEN=<your-prometheus-scrape-token>

# GitHub App (onboarding "Connect repo" flow)
# Install URL is https://github.com/apps/<GITHUB_APP_SLUG>/installations/new
# GITHUB_APP_SLUG is the human-readable name (e.g. eden-observability).
# Do NOT put GITHUB_APP_CLIENT_ID (Iv23…) in the slug — that 404s on GitHub.
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_WEBHOOK_SECRET=
GITHUB_APP_SLUG=eden-observability
GITHUB_APP_CALLBACK_URL=https://edenobservability.com/onboarding/connect

# Cat 1-23 + Cat 14 feature flags (default ON since June 2026).
# Set to "false" to opt out per deployment. The /onboarding flow
# also surfaces these to new users and the Settings page exposes
# per-org opt-out toggles.
INTELLIGENCE_GAP_V0=true
AUTONOMOUS_ACTIONS_V0=true

# N23 — Recurring improvement agent (replaces Cat 23 code-change inbox).
# Requires Alembic migration 099 (improvement_runs + improvement_plans).
# IMPROVEMENT_AGENT_V1 gates the sweep orchestrator and /improve API routes.
# IMPROVEMENT_SCHEDULE_ENABLED wires the 15-min cron tick in eden-cron.
IMPROVEMENT_AGENT_V1=true
IMPROVEMENT_SCHEDULE_ENABLED=true

# ── N16 sampling (soft-launch = full / 100% keep) ───────────────────────────
# Server + SDK default is full so soft-launch traffic is never dropped.
# After soft-launch, for ~80%+ ingest/storage cost reduction without losing
# failures, set:
#   EDEN_SAMPLING_PROFILE=balanced   # ~15% of non-signal traces; errors kept
#   # or EDEN_SAMPLING_PROFILE=aggressive  # ~5%
# Rollback: EDEN_SAMPLING_ENABLED=false (forces 100% keep).
# EDEN_SAMPLING_PROFILE=full
# EDEN_SAMPLING_ENABLED=true

# ── Recent migrations (run via Alembic on API boot) ─────────────────────────
# 098 — F81 NL alert rules: nl_alert_rules, alert_events, alert_triage_feedback
#       (natural-language alert compiler + triage verdict storage)
# 099 — N23 improvement agent: improvement_runs, improvement_plans
#       (recurring sweep inbox with dedup fingerprints + plan lifecycle)
#
# Storage note (Wave 3 deferred): ingest still dual-writes plaintext JSONB +
# *_zstd columns. Readers mostly prefer zstd, but some paths (e.g. online
# rules_engine) still read JSONB first. Do NOT stop dual-write until
# scripts/check_zstd_drop_prerequisites.py gates pass and migration 033/039
# burn-in is complete.
