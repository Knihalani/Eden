# Server
PORT=8790
HOST=127.0.0.1
# tenant:key pairs, keys 16+ chars. Or EDEN_DEV=1 for local, unauthenticated use.
EDEN_API_KEYS=
# EDEN_DEV=1
# EDEN_HOME=~/.eden
# EDEN_SOURCES_FILE=examples/personal-agent/sources.json
# EDEN_TRACE=1

# Model (optional: without a key the engine runs with no model)
OPENROUTER_API_KEY=
EDEN_MODEL=z-ai/glm-5.3-flash
# EDEN_MODEL_ZDR=off          # allow non-ZDR endpoints (development only)
# EDEN_MODEL_PRICE=0.075,0.25 # USD per million input,output tokens, for budgeting
