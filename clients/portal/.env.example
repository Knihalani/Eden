# ─── Eden Portal — environment variables ────────────────────────────
#
# Copy to `.env.local` for local development. In production, set these
# via your hosting provider (Vercel project settings, Northflank
# service runtime-env, etc.).
#
# Public vars (NEXT_PUBLIC_*) are inlined into the client bundle and
# are visible in the browser. Non-prefixed vars are server-only and
# stay on the backend.

# ─── Backend routing ────────────────────────────────────────────────
# Browser-facing API base. The catch-all proxy at /api/proxy/[...path]
# forwards these to FastAPI.
#
# In PRODUCTION: MUST be `/api/proxy` so the request stays same-origin
#   and Set-Cookie survives the hop (Vercel → Northflank is
#   cross-origin and would otherwise block the cookie).
# In DEVELOPMENT: can be `http://localhost:8000` to bypass the proxy
#   for live FastAPI debugging, OR `/api/proxy` if you want to test
#   the proxy itself.
NEXT_PUBLIC_API_URL=/api/proxy

# Server-side FastAPI upstream used by the /api/proxy/[...path] route
# handler. Node's native fetch needs an absolute URL — DO NOT set this
# to `/api/proxy` (the client-safe relative path) or proxy requests
# will fail with "Failed to parse URL".
#
# In PRODUCTION: the FastAPI Northflank service URL, e.g.
#   https://api--<project>.northflank.app
# In DEVELOPMENT: http://localhost:8000 (the default fallback).
API_INTERNAL_URL=

# ─── Clerk authentication ───────────────────────────────────────────
#
# Clerk requires keys from the same "environment":
#   - Development instance: pk_test_*, sk_test_*
#   - Production instance:  pk_live_*, sk_live_*
#
# Using live keys in dev triggers "Production Keys are only allowed
# for domain <your-domain>" errors when you load the portal from
# localhost. Two valid fixes:
#
#   (a) Use Clerk TEST keys in dev. Recommended — keeps prod locked
#       down. Set up a second "Development" instance at
#       dashboard.clerk.com and copy its pk_test_/sk_test_ into
#       `.env.local`.
#   (b) Add `http://localhost:3000` to the Clerk dashboard's
#       "Allowed origins" for the production instance. Easier but
#       means dev sessions sit in the prod user table.
#
# Vercel production:
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Routes Clerk uses after sign-in / sign-up. Keep these aligned with
# the marketing copy (e.g. "Already have an account? Sign in" links).
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/signup

# Where to send the user after each flow completes.
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/onboarding

# ─── Optional ──────────────────────────────────────────────────────
# Public URL of the deployed site, used by Clerk's email templates
# and OAuth callback URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000