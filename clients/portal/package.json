{
  "name": "portal",
  "version": "0.1.0",
  "private": true,
  "sideEffects": false,
  "packageManager": "bun@1.1.42",
  "browserslist": [
    "chrome >= 111",
    "edge >= 111",
    "firefox >= 111",
    "safari >= 16.4"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint:portal-layout": "node scripts/lint-portal-layout.cjs",
    "lint:portal-classes": "node scripts/lint-portal-classes.cjs",
    "lint:portal-clutter": "node scripts/lint-portal-clutter.cjs",
    "check:bundle": "bash scripts/check-bundle-size.sh",
    "analyze": "ANALYZE=true next build --webpack",
    "polish:check": "bash scripts/polish-check.sh",
    "audit:a11y": "node scripts/audit-a11y.cjs",
    "test:golden-helpers": "node --test e2e/golden/helpers-auth-domain.test.mjs",
    "test:visual-smoke": "node e2e/golden/w6-visual-smoke-checklist.mjs",
    "test:visual-smoke:capture": "VISUAL_SMOKE_CAPTURE=1 node e2e/golden/w6-visual-smoke-checklist.mjs",
    "test:e2e-loop": "node e2e/golden/w12-observe-eval-improve.mjs",
    "test:e2e-improve-v3": "node e2e/golden/w10-improve-v3-loop.mjs"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.5.3",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-query": "^5.100.14",
    "@tanstack/react-virtual": "^3.13.12",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "fflate": "^0.8.3",
    "framer-motion": "^12.40.0",
    "lucide-react": "^1.16.0",
    "next": "16.2.10",
    "next-intl": "^4.13.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "recharts": "^3.9.1",
    "rrweb-player": "^2.1.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@axe-core/cli": "^4.12.1",
    "@clerk/testing": "^2.2.9",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.2",
    "dotenv": "^17.2.2",
    "eslint": "^10",
    "eslint-config-next": "16.2.10",
    "jsdom": "^29.1.1",
    "playwright": "^1.61.1",
    "tailwindcss": "^4",
    "typescript": "^6",
    "vitest": "^4.1.8"
  }
}
