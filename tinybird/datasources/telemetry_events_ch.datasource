DESCRIPTION >
    Generated by scripts/gen_tinybird_datasources.py from the
    CREATE TABLE in src/eden/data_platform/clickhouse_sink.py.
    Do not hand-edit: run the script instead, or the two schemas drift
    (they previously disagreed on ~40 column types).

SCHEMA >
    event_id String `json:$.event_id`,
    tenant_id String `json:$.tenant_id`,
    project_id String `json:$.project_id`,
    trace_id String `json:$.trace_id`,
    realm LowCardinality(String) `json:$.realm`,
    event_type LowCardinality(String) `json:$.event_type`,
    timestamp DateTime64(3) `json:$.timestamp`,
    agent_id String `json:$.agent_id`,
    agent_version String `json:$.agent_version`,
    environment_id String `json:$.environment_id`,
    span_id String `json:$.span_id`,
    name String `json:$.name`,
    duration_ms Float64 `json:$.duration_ms`,
    metrics String `json:$.metrics`,
    tags String `json:$.tags`,
    outcome LowCardinality(String) `json:$.outcome`,
    finish_reason LowCardinality(String) `json:$.finish_reason`,
    model LowCardinality(String) `json:$.model`,
    model_version String `json:$.model_version`,
    cache_hit UInt8 `json:$.cache_hit`,
    prompt_cache_savings_usd Float64 `json:$.prompt_cache_savings_usd`,
    ingested_at DateTime64(3) `json:$.ingested_at`

INDEXES >
    INDEX idx_trace_id trace_id TYPE bloom_filter(0.01) GRANULARITY 1

ENGINE "MergeTree"
ENGINE_PARTITION_KEY "toYYYYMM(timestamp)"
ENGINE_SORTING_KEY "tenant_id, timestamp"
ENGINE_TTL "toDateTime(timestamp) + toIntervalDay(90)"
