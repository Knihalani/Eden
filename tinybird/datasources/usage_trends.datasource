DESCRIPTION >
    Generated by scripts/gen_tinybird_datasources.py from the
    CREATE TABLE in src/eden/data_platform/clickhouse_sink.py.
    Do not hand-edit: run the script instead, or the two schemas drift
    (they previously disagreed on ~40 column types).

SCHEMA >
    tenant_id UUID `json:$.tenant_id`,
    user_id UUID `json:$.user_id`,
    event_type LowCardinality(String) `json:$.event_type`,
    resource LowCardinality(String) `json:$.resource`,
    quantity Float64 `json:$.quantity`,
    unit LowCardinality(String) `json:$.unit`,
    model LowCardinality(String) `json:$.model`,
    cost_usd Float64 `json:$.cost_usd`,
    hour DateTime `json:$.hour`,
    date Date `json:$.date` DEFAULT toDate(hour)

ENGINE "MergeTree"
ENGINE_PARTITION_KEY "toYYYYMM(hour)"
ENGINE_SORTING_KEY "tenant_id, event_type, hour"
ENGINE_TTL "hour + toIntervalYear(7)"

FORWARD_QUERY >
    SELECT CAST(tenant_id, 'UUID') AS tenant_id, CAST(user_id, 'UUID') AS user_id, CAST(event_type, 'LowCardinality(String)') AS event_type, CAST(resource, 'LowCardinality(String)') AS resource, CAST(quantity, 'Float64') AS quantity, CAST(unit, 'LowCardinality(String)') AS unit, CAST(model, 'LowCardinality(String)') AS model, CAST(cost_usd, 'Float64') AS cost_usd, hour, defaultValueOfTypeName('Date') AS date
