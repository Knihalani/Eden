DESCRIPTION "Usage trends at hour or day granularity. Mirrors `ClickHouseSink.query_usage_trends`."

NODE usage_trends_q
SQL >
    %
    SELECT
        {% if String(granularity, 'hour') == 'day' %} toDate(hour) {% else %} hour {% end %} AS time_bucket,
        event_type,
        resource,
        sum(quantity) AS total_quantity,
        sum(cost_usd) AS total_cost_usd,
        count() AS event_count
    FROM usage_trends
    WHERE
        1
        {% if defined(tenant_id) %} AND tenant_id = {{ String(tenant_id) }} {% end %}
        {% if defined(start_time) %} AND hour >= parseDateTimeBestEffort({{ String(start_time) }}) {% end %}
        {% if defined(end_time) %} AND hour <= parseDateTimeBestEffort({{ String(end_time) }}) {% end %}
    GROUP BY time_bucket, event_type, resource
    ORDER BY time_bucket DESC
    LIMIT {{ Int32(limit, 1000) }}

TYPE ENDPOINT
