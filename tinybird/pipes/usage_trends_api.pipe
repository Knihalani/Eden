DESCRIPTION "Usage trends at hour or day granularity. Mirrors `ClickHouseSink.query_usage_trends`. Phase 1 note (2026-08): no route in the Eden app calls this endpoint or query_usage_trends; ingest into `usage_trends` is gated OFF by default via tinybird_ingest_unread_datasources_enabled in clickhouse_sink.py. Left deployed (schema-only) rather than dropped so a future consumer does not need a new datasource."

NODE usage_trends_q
SQL >
    %
    SELECT
        {% if String(granularity, 'hour') == 'day' %} toDate(hour) {% else %} hour {% end %} AS time_bucket,
        event_type,
        resource,
        sum(quantity) AS total_quantity,
        sum(cost_usd) AS total_cost_usd,
        count() AS event_count
    FROM usage_trends
    WHERE
        1
        {% if defined(tenant_id) %} AND tenant_id = {{ String(tenant_id) }} {% end %}
        {% if defined(start_time) %} AND hour >= parseDateTimeBestEffort({{ String(start_time) }}) {% end %}
        {% if defined(end_time) %} AND hour <= parseDateTimeBestEffort({{ String(end_time) }}) {% end %}
    GROUP BY time_bucket, event_type, resource
    ORDER BY time_bucket DESC
    LIMIT {{ Int32(limit, 1000) }}

TYPE ENDPOINT
