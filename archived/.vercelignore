# Vercel reads this — NOT .gitignore. Anything listed here is excluded
# from the deployment archive. Source code stays; build/IDE/runtime
# caches go.

# Git internals
.git/
.gitignore.*
*.git

# Node / TS / Next.js build artifacts (Vercel reinstalls + rebuilds)
node_modules/
.next/
.turbo/
.parcel-cache/
dist/
out/
build/
.npm/
.eslintcache
*.tsbuildinfo
bun.lockb

# Python venvs + caches (backend source still uploads, just not venvs)
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.venv/
.venv-test/
venv/
ENV/
env/
*.egg-info/
*.egg

# Sub-projects not deployed to Vercel
docs/
sdk/
eden-sandbox/
supplementaries/
migrations/
tests/
# Root CLI/scripts folder only — do NOT use bare `tools/` (that also
# excludes clients/portal/src/app/(portal)/tools/).
/tools/
docker/
helm/
var/
scripts/
prompts/
golden_datasets/
tinybird/

bench/
examples/
northflank.yml
alembic.ini
mypy.ini
ruff.toml
pyproject.toml
uv.lock
.claude/
.eden/
.codegraph/
.aider*

# Local AI tooling caches (not source of truth)
.aider*
.codegraph/
.eden/

# Editor / OS / secrets
.DS_Store
.vscode/
.idea/
*.swp
*.swo
*~
*.sublime-*
*.pem
*.log
