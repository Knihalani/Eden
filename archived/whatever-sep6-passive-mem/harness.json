{
  "goal": "Passive memory: store everything worth remembering from conversation without explicit remember() calls, then autoinject it later.",
  "branch": "whatever/sep6-passive-mem",
  "timeout_sec": 180,
  "epsilon": 0.01,
  "scope": ["src", "packages/know/src", "packages/wrap/src"],
  "out_of_scope": [".whatever", ".gauntlet", "archived"],
  "primary": {
    "id": "capture-miss",
    "cmd": "bun .whatever/benches/passive-memory.ts",
    "direction": "lower",
    "extract": { "kind": "prefix", "prefix": "metric:" }
  },
  "guards": [
    {
      "id": "inject-tests",
      "cmd": "bun test packages/know/src/need.test.ts packages/know/src/gold-gauntlet.test.ts packages/know/src/inject-rank.test.ts packages/know/src/talk.test.ts packages/wrap/src/know-inject.test.ts packages/wrap/src/intent.test.ts",
      "direction": "higher",
      "extract": { "kind": "exit" }
    },
    {
      "id": "junk-store",
      "cmd": "bun .whatever/benches/passive-memory.ts",
      "direction": "lower",
      "extract": { "kind": "prefix", "prefix": "junk_store:" }
    },
    {
      "id": "probe-miss",
      "cmd": "bun .whatever/benches/passive-memory.ts",
      "direction": "lower",
      "extract": { "kind": "prefix", "prefix": "probe_miss:" }
    }
  ]
}
