ity.com/npm/@clerk/clerk-js@6/dist/clerk.browser.js" data-clerk-js-script="true" async="" crossorigin="anonymous" data-clerk-publishable-key="pk_live_Y2xlcmsuZWRlbm9ic2VydmFiaWxpdHkuY29tJA"></script><meta name="next-size-adjust" content=""/><link rel="preload" href="https://clerk.edenobservability.com/npm/@clerk/ui@1/dist/ui.browser.js" as="script" crossorigin="anonymous"/><title>Data Processing Addendum · Eden</title><meta name="description" content="GDPR-compliant DPA. Standard Contractual Clauses (SCCs). Auto-attached to enterprise contracts."/><meta name="application-name" content="Eden"/><meta name="robots" content="index, follow"/><meta property="og:title" content="Eden — Observability + improvement for AI agents"/><meta property="og:description" content="Drop-in LLM observability, evaluation, and reviewable PR suggestions. Capture every call. Ship every fix."/><meta property="og:url" content="https://edenobservability.com"/><meta property="og:site_name" content="Eden"/><meta property="og:type" content="website"/><meta name="twitter:card" content="summary_large_image"/><meta name="twitter:title" content="Eden — Observability + improvement for AI agents"/><meta name="twitter:description" content="Drop-in LLM observability, evaluation, and reviewable PR suggestions."/><link rel="icon" href="/favicon.ico?favicon.1n2ug3kv_wgzj.ico" sizes="128x128" type="image/x-icon"/><link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48 64x64 128x128" type="image/x-icon"/><link rel="icon" href="/favicon.png" sizes="32x32" type="image/png"/><link rel="icon" href="/favicon.webp" sizes="32x32" type="image/webp"/><link rel="icon" href="/icon-192x192.png" sizes="192x192" type="image/png"/><link rel="icon" href="/icon-192x192.webp" sizes="192x192" type="image/webp"/><link rel="icon" href="/icon-512x512.png" sizes="512x512" type="image/png"/><link rel="icon" href="/icon-512x512.webp" sizes="512x512" type="image/webp"/><link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" type="image/png"/><script src="/_next/static/chunks/0cz1d0mv5g_q7.js" noModule=""></script></head><body class="flex min-h-full flex-col bg-[var(--bg-primary)]"><div hidden=""><!--$--><!--/$--></div><div class="grain-overlay min-h-screen bg-[var(--bg-primary)]"><div class="min-h-screen bg-[var(--bg-secondary)]"><nav class="sticky top-0 z-50 h-16 bg-[var(--bg-primary)]/90 backdrop-blur-xl border-b border-[var(--border-subtle)]"><div class="max-w-5xl mx-auto px-6 h-full flex items-center justify-between gap-4"><a aria-label="Eden home" class="group" href="/"><span class="flex items-center gap-2.5"><img alt="Eden" loading="lazy" width="48" height="48" decoding="async" data-nimg="1" class="h-8 w-8 shrink-0" style="color:transparent" srcSet="/_next/image?url=%2Flogo.webp&amp;w=48&amp;q=75 1x, /_next/image?url=%2Flogo.webp&amp;w=96&amp;q=75 2x" src="/_next/image?url=%2Flogo.webp&amp;w=96&amp;q=75"/><span class="text-lg font-semibold tracking-tight text-[var(--text-primary)] truncate">Eden</span></span></a><div class="flex items-center gap-1 sm:gap-2"><a class="hidden sm:inline-flex items-center min-h-11 px-3 text-sm text-[var(--text-secondary)] hover:text-[var(--text-primary)] transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--accent)] rounded-lg" href="/pricing">Pricing</a><a class="inline-flex items-center justify-center min-h-11 px-4 text-sm font-medium bg-[var(--accent)] text-[var(--bg-base)] rounded-lg hover:bg-[var(--accent-hover)] transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--accent)] focus-visible:ring-offset-2 focus-visible:ring-offset-[var(--bg-primary)]" href="/sign-up">Start free</a><a class="inline-flex items-center gap-1.5 min-h-11 px-2 text-sm text-[var(--text-secondary)] hover:text-[var(--text-primary)] transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--accent)] rounded-lg" href="/"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-left w-4 h-4" aria-hidden="true"><path d="m15 18-6-6 6-6"></path></svg>Back to home</a></div></div></nav><main class="mx-auto px-6 py-16 max-w-3xl"><p class="text-[11px] font-mono font-semibold uppercase tracking-widest text-[var(--accent)] mb-3">Legal</p><h1 class="text-4xl md:text-5xl font-bold text-[var(--text-primary)] mb-4" style="letter-spacing:-0.03em;line-height:1.05">Data Processing Addendum</h1><p class="text-base text-[var(--text-secondary)] mb-12 leading-relaxed">Eden&#x27;s DPA is auto-attached to every paid order form. It incorporates the EU Standard Contractual Clauses (SCCs) for international data transfers and designates Eden as a<!-- --> <strong>Processor</strong> <!-- -->acting on the Customer&#x27;s documented instructions.</p><div role="status" class="mb-8 flex items-start gap-3 rounded-lg border border-[var(--warning)]/40 bg-[var(--warning)]/10 px-4 py-3 text-sm text-[var(--warning)]"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-file-exclamation-point h-4 w-4 shrink-0 mt-0.5" aria-hidden="true"><path d="M6 22a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h8a2.4 2.4 0 0 1 1.704.706l3.588 3.588A2.4 2.4 0 0 1 20 8v12a2 2 0 0 1-2 2z"></path><path d="M12 9v4"></path><path d="M12 17h.01"></path></svg><p>Draft for review — clauses on this page have not received final counsel sign-off. Do not rely on this text for contractual purposes until the published DPA is countersigned.</p></div><div class="bg-[var(--bg-primary)] border border-[var(--border-default)] rounded-xl p-6 mb-10 flex items-start gap-4"><div class="w-12 h-12 rounded-lg bg-[var(--accent-faint)] border border-[var(--accent)]/20 flex items-center justify-center text-[var(--accent)] shrink-0"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-file-text w-6 h-6" aria-hidden="true"><path d="M6 22a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h8a2.4 2.4 0 0 1 1.704.706l3.588 3.588A2.4 2.4 0 0 1 20 8v12a2 2 0 0 1-2 2z"></path><path d="M14 2v5a1 1 0 0 0 1 1h5"></path><path d="M10 9H8"></path><path d="M16 13H8"></path><path d="M16 17H8"></path></svg></div><div class="flex-1"><h2 class="text-base font-semibold text-[var(--text-primary)] mb-1">Download the DPA</h2><p class="text-sm text-[var(--text-muted)] mb-3">Signed copy auto-attached to your order form. For pre-sales review, download the unsigned template below.</p><a class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium bg-[var(--accent)] text-[var(--accent-foreground)] hover:bg-[var(--accent-hover)] rounded-lg transition-colors" href="/api/dpa/download"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-download w-3.5 h-3.5" aria-hidden="true"><path d="M12 15V3"></path><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><path d="m7 10 5 5 5-5"></path></svg>Download DPA template (PDF)</a></div></div><div class="space-y-12"><section id="roles-and-scope" class="scroll-mt-20"><div class="flex items-center gap-3 mb-4"><div class="w-9 h-9 rounded-lg bg-[var(--accent-faint)] border border-[var(--accent)]/20 flex items-center justify-center text-[var(--accent)] shrink-0"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-users w-4.5 h-4.5" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path><path d="M16 3.128a4 4 0 0 1 0 7.744"></path><path d="M22 21v-2a4 4 0 0 0-3-3.87"></path><circle cx="9" cy="7" r="4"></circle></svg></div><h2 class="text-xl font-semibold text-[var(--text-primary)] tracking-tight">Roles and scope</h2></div><div class="space-y-3 text-sm text-[var(--text-secondary)] leading-relaxed"><p>Customer is the <strong>Controller</strong>. Eden is the<!-- --> <strong>Processor</strong>. Eden processes Customer Personal Data only on documented instructions from the Customer, including with regard to international transfers, unless required to do so by applicable law.</p></div></section><section id="subprocessors" class="scroll-mt-20"><div class="flex items-center gap-3 mb-4"><div class="w-9 h-9 rounded-lg bg-[var(--accent-faint)] border border-[var(--accent)]/20 flex items-center justify-center text-[var(--accent)] shrink-0"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-inbox w-4.5 h-4.5" aria-hidden="true"><polyline points="22 12 16 12 14 15 10 15 8 12 2 12"></polyline><path d="M5.45 5.11 2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z"></path></svg></div><h2 class="text-xl font-semibold text-[var(--text-primary)] tracking-tight">Subprocessors</h2></div><div class="space-y-3 text-sm text-[var(--text-secondary)] leading-relaxed"><p>Eden engages the following subprocessor categories. A current list with regions is maintained at<!-- --> <a class="text-[var(--accent)] hover:underline" href="/security">/security</a>; changes are notified 30 days in advance.</p><ul class="list-disc list-outside pl-6 space-y-1 mt-3 text-sm text-[var(--text-secondary)]"><li>Postgres hosting (AWS, region selected by Customer)</li><li>ClickHouse hosting (AWS, region selected by Customer)</li><li>Object storage for exports (AWS S3, region selected by Customer)</li><li>Email delivery (Postmark, US)</li><li>Error reporting (Sentry, US)</li><li>Status page (Statuspage, US)</li></ul></div></section><section id="international-transfers" class="scroll-mt-20"><div class="flex items-center gap-3 mb-4"><div class="w-9 h-9 rounded-lg bg-[var(--accent-faint)] border border-[var(--accent)]/20 flex items-center justify-center text-[var(--accent)] shrink-0"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-globe w-4.5 h-4.5" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"></path><path d="M2 12h20"></path></svg></div><h2 class="text-xl font-semibold text-[var(--text-primary)] tracking-tight">International transfers</h2></div><div class="space-y-3 text-sm text-[var(--text-secondary)] leading-relaxed"><p>For transfers outside the EEA, UK, or Switzerland, Eden relies on the EU Standard Contractual Clauses (Module 2: Controller-to-Processor). The SCCs are incorporated by reference into the DPA. Customer may execute the SCCs as a separate addendum if required.</p></div></section><section id="security-measures" class="scroll-mt-20"><div class="flex items-center gap-3 mb-4"><div class="w-9 h-9 rounded-lg bg-[var(--accent-faint)] border border-[var(--accent)]/20 flex items-center justify-center text-[var(--accent)] shrink-0"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-shield-check w-4.5 h-4.5" aria-hidden="true"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"></path><path d="m9 12 2 2 4-4"></path></svg></div><h2 class="text-xl font-semibold text-[var(--text-primary)] tracking-tight">Security measures</h2></div><div class="space-y-3 text-sm text-[var(--text-secondary)] leading-relaxed"><p>Eden implements technical and organisational measures as documented in our<!-- --> <a class="text-[var(--accent)] hover:underline" href="/security">Security page</a>, including encryption in transit (HTTPS/TLS), per-tenant data isolation, RBAC with audit logging where implemented, and the controls described on our Security page. Formal third-party audit reports are not offered during soft launch.</p></div></section><section id="data-subject-requests" class="scroll-mt-20"><div class="flex items-center gap-3 mb-4"><div class="w-9 h-9 rounded-lg bg-[var(--accent-faint)] border border-[var(--accent)]/20 flex items-center justify-center text-[var(--accent)] shrink-0"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-mail w-4.5 h-4.5" aria-hidden="true"><path d="m22 7-8.991 5.727a2 2 0 0 1-2.009 0L2 7"></path><rect x="2" y="4" width="20" height="16" rx="2"></rect></svg></div><h2 class="text-xl font-semibold text-[var(--text-primary)] tracking-tight">Data subject requests</h2></div><div class="space-y-3 text-sm text-[var(--text-secondary)] leading-relaxed"><p>Eden will assist the Customer in fulfilling data-subject requests (access, rectification, erasure, portability, restriction, objection) by providing self-service tools in the dashboard and a 72-hour-acknowledgement SLA for requests received via<!-- --> <a href="mailto:privacy@eden.dev" class="text-[var(--accent)] hover:underline">privacy@eden.dev</a>.</p></div></section><section id="breach-notification" class="scroll-mt-20"><div class="flex items-center gap-3 mb-4"><div class="w-9 h-9 rounded-lg bg-[var(--accent-faint)] border border-[var(--accent)]/20 flex items-center justify-center text-[var(--accent)] shrink-0"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-triangle-alert w-4.5 h-4.5" aria-hidden="true"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3"></path><path d="M12 9v4"></path><path d="M12 17h.01"></path></svg></div><h2 class="text-xl font-semibold text-[var(--text-primary)] tracking-tight">Breach notification</h2></div><div class="space-y-3 text-sm text-[var(--text-secondary)] leading-relaxed"><p>Eden will notify the Customer without undue delay, and in any case within 72 hours, of any Personal Data breach affecting Customer data. Notification includes the nature of the breach, categories and approximate number of data subjects affected, likely consequences, and measures taken.</p></div></section><section id="return-and-deletion" class="scroll-mt-20"><div class="flex items-center gap-3 mb-4"><div class="w-9 h-9 rounded-lg bg-[var(--accent-faint)] border border-[var(--accent)]/20 flex items-center justify-center text-[var(--accent)] shrink-0"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-trash2 lucide-trash-2 w-4.5 h-4.5" aria-hidden="true"><path d="M10 11v6"></path><path d="M14 11v6"></path><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"></path><path d="M3 6h18"></path><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg></div><h2 class="text-xl font-semibold text-[var(--text-primary)] tracking-tight">Return and deletion</h2></div><div class="space-y-3 text-sm text-[var(--text-secondary)] leading-relaxed"><p>On termination, Eden will return all Customer Personal Data in a machine-readable format (JSONL / CSV) within 30 days, then permanently delete all copies within a further 30 days, unless retention is required by law.</p></div></section></div><div class="mt-16 pt-8 border-t border-[var(--border-subtle)]"><p class="text-xs text-[var(--text-muted)]">DPA version 3.2 · Last updated: June 30, 2026. This page is a summary — the signed DPA attached to your order form is the legally-binding document.</p></div></main><footer class="border-t border-[var(--border-subtle)] mt-16"><div class="mx-auto px-6 py-8 max-w-5xl flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between"><div class="flex flex-wrap items-center gap-x-5 gap-y-2 text-sm text-[var(--text-secondary)]"><a class="hover:text-[var(--text-primary)] transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--accent)] rounded" href="/about">About</a><a class="hover:text-[var(--text-primary)] transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--accent)] rounded" href="/pricing">Pricing</a><a class="hover:text-[var(--text-primary)] transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--accent)] rounded" href="/contact">Contact</a><a class="hover:text-[var(--text-primary)] transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--accent)] rounded" href="/changelog">Changelog</a><a class="hover:text-[var(--text-primary)] transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--accent)] rounded" href="/privacy">Privacy</a><a class="hover:text-[var(--text-primary)] transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--accent)] rounded" href="/terms">Terms</a><a class="hover:text-[var(--text-primary)] transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--accent)] rounded" href="/dpa">DPA</a><a class="hover:text-[var(--text-primary)] transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--accent)] rounded" href="/security">Security</a><span class="inline-flex items-baseline gap-1.5 whitespace-nowrap"><