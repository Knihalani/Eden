{
  "description": "Eden passive memory — observe conversation, inject relevant notes. Fail-open.",
  "hooks": {
    "UserPromptSubmit": [{ "hooks": [{ "type": "command", "command": "bun --no-install \"${CLAUDE_PLUGIN_ROOT}/scripts/hook.ts\" 2>/dev/null || true" }] }],
    "SessionStart": [{ "hooks": [{ "type": "command", "command": "bun --no-install \"${CLAUDE_PLUGIN_ROOT}/scripts/hook.ts\" 2>/dev/null || true" }] }],
    "SubagentStart": [{ "hooks": [{ "type": "command", "command": "bun --no-install \"${CLAUDE_PLUGIN_ROOT}/scripts/hook.ts\" 2>/dev/null || true" }] }],
    "PreCompact": [{ "hooks": [{ "type": "command", "command": "bun --no-install \"${CLAUDE_PLUGIN_ROOT}/scripts/hook.ts\" 2>/dev/null || true" }] }],
    "PostCompact": [{ "hooks": [{ "type": "command", "command": "bun --no-install \"${CLAUDE_PLUGIN_ROOT}/scripts/hook.ts\" 2>/dev/null || true" }] }],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "bun --no-install \"${CLAUDE_PLUGIN_ROOT}/scripts/hook.ts\" stop-fast 2>/dev/null || true" },
          { "type": "command", "command": "bun --no-install \"${CLAUDE_PLUGIN_ROOT}/scripts/hook.ts\" stop-sleep 2>/dev/null || true", "async": true }
        ]
      }
    ],
    "SessionEnd": [{ "hooks": [{ "type": "command", "command": "bun --no-install \"${CLAUDE_PLUGIN_ROOT}/scripts/hook.ts\" 2>/dev/null || true" }] }],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "bun --no-install \"${CLAUDE_PLUGIN_ROOT}/scripts/hook.ts\" guard 1 2>/dev/null || true", "if": "Bash(*migrate reset*)", "timeout": 5 },
          { "type": "command", "command": "bun --no-install \"${CLAUDE_PLUGIN_ROOT}/scripts/hook.ts\" guard 2 2>/dev/null || true", "if": "Bash(*db drop*)", "timeout": 5 },
          { "type": "command", "command": "bun --no-install \"${CLAUDE_PLUGIN_ROOT}/scripts/hook.ts\" guard 3 2>/dev/null || true", "if": "Bash(psql *)", "timeout": 5 },
          { "type": "command", "command": "bun --no-install \"${CLAUDE_PLUGIN_ROOT}/scripts/hook.ts\" guard 4 2>/dev/null || true", "if": "Bash(git *)", "timeout": 5 },
          { "type": "command", "command": "bun --no-install \"${CLAUDE_PLUGIN_ROOT}/scripts/hook.ts\" guard 5 2>/dev/null || true", "if": "Bash(npm *)", "timeout": 5 },
          { "type": "command", "command": "bun --no-install \"${CLAUDE_PLUGIN_ROOT}/scripts/hook.ts\" guard 6 2>/dev/null || true", "if": "Bash(pnpm *)", "timeout": 5 },
          { "type": "command", "command": "bun --no-install \"${CLAUDE_PLUGIN_ROOT}/scripts/hook.ts\" guard 7 2>/dev/null || true", "if": "Bash(yarn *)", "timeout": 5 },
          { "type": "command", "command": "bun --no-install \"${CLAUDE_PLUGIN_ROOT}/scripts/hook.ts\" guard 8 2>/dev/null || true", "if": "Bash(bun *)", "timeout": 5 },
          { "type": "command", "command": "bun --no-install \"${CLAUDE_PLUGIN_ROOT}/scripts/hook.ts\" guard 9 2>/dev/null || true", "if": "Bash(pip *)", "timeout": 5 },
          { "type": "command", "command": "bun --no-install \"${CLAUDE_PLUGIN_ROOT}/scripts/hook.ts\" guard 10 2>/dev/null || true", "if": "Bash(cargo *)", "timeout": 5 },
          { "type": "command", "command": "bun --no-install \"${CLAUDE_PLUGIN_ROOT}/scripts/hook.ts\" guard 11 2>/dev/null || true", "if": "Bash(*deploy*)", "timeout": 5 },
          { "type": "command", "command": "bun --no-install \"${CLAUDE_PLUGIN_ROOT}/scripts/hook.ts\" guard 12 2>/dev/null || true", "if": "Bash(vercel *)", "timeout": 5 },
          { "type": "command", "command": "bun --no-install \"${CLAUDE_PLUGIN_ROOT}/scripts/hook.ts\" guard 13 2>/dev/null || true", "if": "Bash(fly *)", "timeout": 5 },
          { "type": "command", "command": "bun --no-install \"${CLAUDE_PLUGIN_ROOT}/scripts/hook.ts\" guard 14 2>/dev/null || true", "if": "Bash(kubectl *)", "timeout": 5 },
          { "type": "command", "command": "bun --no-install \"${CLAUDE_PLUGIN_ROOT}/scripts/hook.ts\" guard 15 2>/dev/null || true", "if": "Bash(rm *)", "timeout": 5 },
          { "type": "command", "command": "bun --no-install \"${CLAUDE_PLUGIN_ROOT}/scripts/hook.ts\" guard 16 2>/dev/null || true", "if": "Bash(gh *)", "timeout": 5 }
        ]
      },
      { "matcher": "mcp__.*__merge.*", "hooks": [{ "type": "command", "command": "bun --no-install \"${CLAUDE_PLUGIN_ROOT}/scripts/hook.ts\" guard 17 2>/dev/null || true", "timeout": 5 }] },
      { "matcher": "Agent", "hooks": [{ "type": "command", "command": "bun --no-install \"${CLAUDE_PLUGIN_ROOT}/scripts/hook.ts\" spawn 2>/dev/null || true", "timeout": 5 }] }
    ],
    "PostToolBatch": [{ "hooks": [{ "type": "command", "command": "bun --no-install \"${CLAUDE_PLUGIN_ROOT}/scripts/hook.ts\" 2>/dev/null || true" }] }],
    "SubagentStop": [{ "hooks": [{ "type": "command", "command": "bun --no-install \"${CLAUDE_PLUGIN_ROOT}/scripts/hook.ts\" 2>/dev/null || true", "async": true }] }],
    "InstructionsLoaded": [{ "hooks": [{ "type": "command", "command": "bun --no-install \"${CLAUDE_PLUGIN_ROOT}/scripts/hook.ts\" 2>/dev/null || true", "async": true }] }],
    "FileChanged": [{ "hooks": [{ "type": "command", "command": "bun --no-install \"${CLAUDE_PLUGIN_ROOT}/scripts/hook.ts\" 2>/dev/null || true", "timeout": 10 }] }],
    "CwdChanged": [{ "hooks": [{ "type": "command", "command": "bun --no-install \"${CLAUDE_PLUGIN_ROOT}/scripts/hook.ts\" 2>/dev/null || true", "timeout": 10 }] }]
  }
}
