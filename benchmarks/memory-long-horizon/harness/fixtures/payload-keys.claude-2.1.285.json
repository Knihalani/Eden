  "formats": {
    "prompt_id": "uuid v4",
    "tool_use_id": "^toolu_01[A-Za-z0-9]{22}$",
    "agent_id": "^a[0-9a-f]{16}$",
    "transcript_path": "<home>/.claude/projects/<cwd with every non-alphanumeric character replaced by '-'>/<session_id>.jsonl",
    "agent_transcript_path": "<home>/.claude/projects/<slug>/<session_id>/subagents/agent-<agent_id>.jsonl",
    "PostToolBatch.tool_calls[].tool_response": "the serialized tool_result content: Read gives line-numbered text, Bash gives stdout, a failed Bash gives the PostToolUseFailure error string ('Exit code 1'), Agent gives a content-block array",
    "event_order": [
      "startup: InstructionsLoaded(session_start) before SessionStart(startup)",
      "tool call: PreToolUse, then PostToolUse or PostToolUseFailure, then one PostToolBatch per batch",
      "Agent call: PreToolUse(Agent), SubagentStart, the subagent's own tool events, SubagentStop, PostToolUse(Agent), PostToolBatch",
      "/compact: PreCompact, SubagentStop of the internal compaction agent (agent_type ''), SessionStart(compact), PostCompact",
      "resume: InstructionsLoaded(session_start) before SessionStart(resume)"
    ]
  },
  "sequences": {
    "tool-and-subagent-run": [
      "InstructionsLoaded|main|session_start",
      "SessionStart|main|startup",
      "UserPromptSubmit|main",
      "PreToolUse|main|Read",
      "PostToolUse|main|Read",
      "PostToolBatch|main",
      "PreToolUse|main|Bash",
      "PostToolUse|main|Bash",
      "PreToolUse|main|Bash",
      "PostToolUse|main|Bash",
      "PostToolBatch|main",
      "PreToolUse|main|Bash",
      "PostToolUseFailure|main|Bash",
      "PostToolBatch|main",
      "PreToolUse|main|Agent",
      "SubagentStart|subagent",
      "PreToolUse|subagent|Read",
      "PostToolUse|subagent|Read",
      "PostToolBatch|subagent",
      "SubagentStop|subagent",
      "PostToolUse|main|Agent",
      "PostToolBatch|main",
      "Stop|main",
      "SessionEnd|main"
    ],
    "resume-then-compact": [
      "InstructionsLoaded|main|session_start",
      "SessionStart|main|resume",
      "InstructionsLoaded|main|session_start",
      "PreCompact|main|manual",
      "SubagentStop|internal-agent",
      "SessionStart|main|compact",
      "PostCompact|main|manual",
      "SessionEnd|main"
    ]
  },
  "sequences_note": "Each session's events in the order the probe's files were written (mtime, ns); keys as in `shapes`."
