{
  "healthChecks": [
    {
      "protocol": "HTTP",
      "type": "readinessProbe",
      "path": "/ready",
      "port": 8000,
      "initialDelaySeconds": 60,
      "periodSeconds": 30,
      "timeoutSeconds": 5,
      "failureThreshold": 3,
      "successThreshold": 1
    },
    {
      "protocol": "HTTP",
      "type": "livenessProbe",
      "path": "/live",
      "port": 8000,
      "initialDelaySeconds": 300,
      "periodSeconds": 60,
      "timeoutSeconds": 10,
      "failureThreshold": 5,
      "successThreshold": 1
    }
  ]
}
