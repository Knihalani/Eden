# A cluster node (docs/DEPLOY.md §9). Copy to .env (chmod 600); never commit. Same keys on every node.
PRIVATE_IP=10.0.1.11
EDEN_API_KEYS=acme:REPLACE_WITH_openssl_rand_hex_24
EDEN_PERSIST_KEY=REPLACE_WITH_openssl_rand_hex_32
EDEN_CLUSTER_KEY=REPLACE_WITH_openssl_rand_hex_24
# Machines in the cluster: divides each tenant's model spend cap (D993). Update it when the count changes.
EDEN_CLUSTER_SIZE=3
# The shared store (D992): an S3-compatible bucket every node reaches, with a 7-day lifecycle rule.
EDEN_PERSIST_STORE=s3://eden-frozen/frozen/
EDEN_S3_ENDPOINT=https://fsn1.your-objectstorage.com
EDEN_S3_REGION=fsn1
EDEN_S3_ACCESS_KEY_ID=REPLACE
EDEN_S3_SECRET_ACCESS_KEY=REPLACE
