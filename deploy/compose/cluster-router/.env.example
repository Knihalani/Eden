# The cluster router (docs/DEPLOY.md §9). Copy to .env (chmod 600); never commit.
EDEN_DOMAIN=eden.example.com
ACME_EMAIL=ops@example.com
# The same tenant keys as every node (the router reads the tenant from the key to hold its whole rate, D993).
EDEN_API_KEYS=acme:REPLACE_WITH_openssl_rand_hex_24
# The same cluster key as every node.
EDEN_CLUSTER_KEY=REPLACE_WITH_openssl_rand_hex_24
