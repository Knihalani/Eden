# Copy to .env (chmod 600), fill in, never commit. Every value here is a secret or names one (docs/DEPLOY.md §4).

# The public name Caddy gets a certificate for; its DNS record points at this box.
EDEN_DOMAIN=eden.example.com
ACME_EMAIL=ops@example.com

# One tenant:key pair per tenant, comma-separated; each key from `openssl rand -hex 24`.
EDEN_API_KEYS=acme:REPLACE_WITH_openssl_rand_hex_24

# Idle users are kept across restarts, encrypted (D991). Make it ONCE with `openssl rand -hex 32` and keep a copy in
# your password manager: a new key discards every persisted user (they re-sync). Or EDEN_PERSIST=off instead.
EDEN_PERSIST_KEY=REPLACE_WITH_openssl_rand_hex_32

# Optional: the model roles (Haiku through OpenRouter, D112). Unset: the no-model default, $0 a call.
# OPENROUTER_API_KEY=

# Optional: per-user connectors (mount the file and name its path inside the container).
# EDEN_USER_SOURCES_FILE=/sources/users.json
