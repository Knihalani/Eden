# Optional defaults — the local dashboard can override all of these at runtime.

# Eden (required to see traces at https://edenobservability.com)
EDEN_ORG_ID=org_...
EDEN_ORG_API_KEY=sk_eden_...
EDEN_BASE_URL=https://api.edenobservability.com
EDEN_PROJECT_ID=openrouter-smoke-agent

# OpenRouter (required to call a model)
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL=openai/gpt-4o-mini

# Local dashboard
PORT=4173
