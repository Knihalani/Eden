# Eden prod (required) — https://docs.edenobservability.com/quickstart
EDEN_ORG_ID=your-org-uuid
EDEN_API_KEY=eden_api_key_...
EDEN_BASE_URL=https://api.edenobservability.com
EDEN_PROJECT_ID=minimax-pydantic-agent

# MiniMax OpenAI-compatible (required) — https://platform.minimax.io/docs/api-reference/text-openai-api
MINIMAX_API_KEY=sk-cp-...
MINIMAX_BASE_URL=https://api.minimax.io/v1
MINIMAX_MODEL=MiniMax-M3

# Optional prompt override for one-shot CLI runs
# AGENT_PROMPT=What time is it UTC, and what is (19.5 + 2.5) * 3? Also look up Singapore.
