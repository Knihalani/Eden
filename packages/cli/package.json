{
  "name": "eden",
  "version": "0.1.0",
  "description": "Compiles repeated agent tool-call patterns into single-call tools. Domain-general, fail-safe, measured.",
  "type": "module",
  "bin": {
    "eden": "./dist/eden.js"
  },
  "files": [
    "dist/eden.js",
    "README.md"
  ],
  "scripts": {
    "build": "bash ../../scripts/build-cli.sh",
    "prepublishOnly": "bun run build"
  },
  "engines": {
    "bun": ">=1.1.0"
  },
  "keywords": [
    "ai",
    "agent",
    "llm",
    "tool-calling",
    "claude",
    "openai",
    "mcp"
  ],
  "license": "MIT",
  "dependencies": {
    "@eden/measure": "workspace:*",
    "@eden/know": "workspace:*"
  }
}
