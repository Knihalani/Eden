{
  "name": "@kaiavn/eden",
  "version": "0.1.0",
  "description": "Eden CLI: passive memory for coding agents (hooks, setup, doctor, store maintenance). Also runs the retired compile-era commands.",
  "type": "module",
  "bin": {
    "eden": "./dist/eden.js"
  },
  "files": [
    "dist/eden.js",
    "dist/demo.js",
    "README.md"
  ],
  "scripts": {
    "build": "bash ../../scripts/build-cli.sh",
    "prepublishOnly": "EDEN_SKIP_CHECKS=1 bun run build"
  },
  "engines": {
    "bun": ">=1.1.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KaiavN/Eden.git",
    "directory": "packages/cli"
  },
  "keywords": [
    "ai",
    "agent",
    "llm",
    "tool-calling",
    "claude",
    "openai",
    "mcp"
  ],
  "license": "MIT",
  "devDependencies": {
    "@eden/control": "workspace:*",
    "@eden/core": "workspace:*",
    "@eden/ir": "workspace:*",
    "@eden/know": "workspace:*",
    "@eden/measure": "workspace:*",
    "@eden/shadow": "workspace:*",
    "@eden/wrap": "workspace:*"
  }
}
