              "crm:contact-dana-lee"
            ]
          }
        },
        {
          "event": {
            "kind": "agent_message",
            "text": "She prefers calls on Tuesdays."
          },
          "expect": "silent"
        },
        {
          "event": {
            "kind": "user_message",
            "text": "Thanks!"
          },
          "expect": "silent"
        }
      ]
    }
  ]
