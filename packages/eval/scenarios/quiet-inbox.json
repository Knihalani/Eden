      "docs": [
        {
          "ref": "msg-lunch",
          "title": "Lunch on Friday?",
          "text": "Sam: fancy lunch at Padella on Friday at 1?"
        },
        {
          "ref": "msg-receipt",
          "title": "Your Uber receipt",
          "text": "Thursday trip, 14.20 GBP."
        }
      ]
    }
  ],
  "sessions": [
