{
  "name": "@kaiavn/sdk",
  "version": "0.1.0",
  "description": "Eden JS SDK: wrap tool calls so repeated agent workflows route onto compiled tools, falling back to your originals on any failure.",
  "type": "module",
  "main": "dist/index.js",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "bun": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "bun build src/index.ts --outfile dist/index.js --target=node --format=esm --packages=external",
    "prepublishOnly": "bun run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KaiavN/Eden.git",
    "directory": "packages/sdk-js"
  },
  "keywords": [
    "ai",
    "agent",
    "llm",
    "tool-calling",
    "mcp"
  ],
  "license": "MIT"
}
