{
  "name": "eden",
  "private": true,
  "packageManager": "bun@1.3.13",
  "workspaces": [
    "apps/*",
    "packages/*",
    "benchmarks/*"
  ],
  "scripts": {
    "test": "./scripts/test.sh",
    "test:parallel": "./scripts/test-parallel.sh",
    "measure:slice": "bun scripts/slice-measure.ts",
    "dev": "bun run --cwd apps/web dev",
    "demo": "bun run --cwd apps/control src/demo.ts",
    "cli": "bun run packages/cli/src/cli.ts",
    "know": "bun run packages/know/src/cli.ts",
    "bench": "bun run packages/runtime/src/bench.ts",
    "typecheck": "./scripts/typecheck.sh",
    "format": "./scripts/format.sh",
    "format:check": "./scripts/format.sh --check",
    "bench:verdict": "bun run packages/measure/src/analyze.ts apps/site/scripts/bench-horizon-results.json apps/site/scripts/bench-horizon-hard-results.json apps/site/scripts/bench-horizon-harder-results.json apps/site/scripts/bench-horizon-product-results.json apps/site/scripts/bench-workshop-results.json",
    "bench:loop": "bun run packages/runtime/src/bench-loop.ts",
    "bench:guard": "bun run packages/runtime/src/bench-guard.ts",
    "bench:campaign": "bun run benchmarks/campaign/bench-campaign.ts",
    "bench:holdout": "bun run benchmarks/campaign/bench-holdout.ts",
    "bench:holdout-short": "bun run benchmarks/campaign/bench-holdout.ts --short --fast",
    "bench:moonshot": "bun run benchmarks/campaign/bench-moonshot.ts",
    "bench:horizon": "bun run benchmarks/campaign/bench-horizon.ts",
    "bench:horizon-short": "bun run benchmarks/campaign/bench-horizon.ts --short --fast",
    "test:apex": "bun test benchmarks/campaign/apex.test.ts",
    "test:helix": "bun test benchmarks/campaign/helix.test.ts",
    "bench:helix": "bun run benchmarks/campaign/bench-helix.ts",
    "bench:helix-short": "bun run benchmarks/campaign/bench-helix.ts --short --fast",
    "bench:negative": "bun run benchmarks/campaign/bench-negative.ts",
    "bench:calibrate": "bun run benchmarks/campaign/calibrate.ts",
    "bench:coverage": "bun run benchmarks/campaign/bench-coverage.ts",
    "bench:8-witness": "bun run benchmarks/campaign/bench-8-witness.ts",
    "bench:timeout": "bun run benchmarks/campaign/bench-timeout.ts",
    "bench:matrix": "bun run benchmarks/campaign/concurrency-matrix.ts",
    "bench:jit-soak": "bun run benchmarks/campaign/jit-soak.ts",
    "bench:jit-id-soak": "bun run benchmarks/campaign/jit-id-soak.ts",
    "bench:jit-cli-soak": "bun run benchmarks/campaign/jit-cli-soak.ts",
    "bench:jit-url-soak": "bun run benchmarks/campaign/jit-url-soak.ts",
    "bench:jit-intent-soak": "bun run benchmarks/campaign/jit-intent-soak.ts",
    "bench:memory-locked": "bun run benchmarks/memory-scale/locked-2k.ts",
    "bench:memory-hard": "bun run benchmarks/memory-scale/hard.ts",
    "test:corpus": "bun test packages/compile/src/corpus",
    "test:compile": "bun test packages/compile",
    "test:flake": "./scripts/flake-audit.sh"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "prettier": "3.9.9",
    "typescript": "5.9.3"
  }
}
