{
  "name": "eden",
  "private": true,
  "packageManager": "bun@1.3.13",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "dev": "bun run packages/server/src/main.ts",
    "test": "./scripts/test.sh",
    "typecheck": "./scripts/typecheck.sh",
    "format": "./scripts/format.sh",
    "format:check": "./scripts/format.sh --check",
    "eval": "bun run packages/eval/src/cli.ts",
    "check": "bun run format:check && bun run typecheck && bun run test",
    "sim": "bun run packages/sim/src/quality-cli.ts",
    "sim:perf": "bun run packages/sim/src/perf-cli.ts",
    "sim:lab:build": "bun run packages/sim/src/lab/build.ts",
    "sim:lab": "bun run packages/sim/src/lab/lab-cli.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "prettier": "3.9.9",
    "typescript": "5.9.3"
  }
}
