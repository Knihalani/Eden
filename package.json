{
  "name": "eden",
  "private": true,
  "packageManager": "bun@1.3.13",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "test": "./scripts/test.sh",
    "dev": "bun run --cwd apps/web dev",
    "demo": "bun run --cwd apps/control src/demo.ts",
    "cli": "bun run packages/cli/src/cli.ts",
    "bench": "bun run packages/runtime/src/bench.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "5.9.3"
  }
}
