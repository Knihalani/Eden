{
  "name": "eden",
  "private": true,
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "dev": "bun run packages/server/src/main.ts",
    "test": "./scripts/test.sh",
    "test:changed": "bun scripts/test-select.ts changed",
    "test:pkg": "bun scripts/test-select.ts pkg",
    "typecheck": "./scripts/typecheck.sh",
    "typecheck:fast": "TYPECHECK=tsgo ./scripts/typecheck.sh",
    "typecheck:parity": "TYPECHECK=parity ./scripts/typecheck.sh",
    "format": "./scripts/format.sh",
    "format:check": "./scripts/format.sh --check",
    "eval": "bun run packages/eval/src/cli.ts",
    "check": "bun run format:check && bun run typecheck && bun run test",
    "check:fast": "bun run format:check && bun run typecheck:fast && bun run test:changed",
    "sim": "bun run packages/sim/src/quality-cli.ts",
    "sim:perf": "bun run packages/sim/src/perf-cli.ts",
    "sim:lab:build": "bun run packages/sim/src/lab/build.ts",
    "sim:lab": "bun run packages/sim/src/lab/lab-cli.ts",
    "proxy": "bun packages/proxy/src/main.ts",
    "pack:client": "bun packages/client/pack.ts",
    "trace-report": "bun packages/server/src/trace-report.ts",
    "demo": "bun packages/sim/src/demo.ts",
    "pilot": "bun packages/sim/src/pilot/pilot.ts",
    "digest": "bun packages/server/src/digest.ts",
    "funnel": "bun packages/sim/src/lab/funnel.ts",
    "gate-traffic": "bun packages/sim/src/lab/gate-traffic.ts",
    "decisions:index": "bun scripts/decision-index.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "prettier": "3.9.9",
    "typescript": "5.9.3"
  }
}
